{
  "version": "1.0.0",
  "description": "Sheria za alarm (sauti + vibration + notification)",
  "rules": [
    {
      "id": "arrival",
      "trigger": "destination_reached",
      "voice_key": "you_have_arrived",
      "vibrate": true,
      "priority": "high"
    },
    {
      "id": "hazard_critical",
      "trigger": "hazard_severity_critical",
      "voice_key": "hazard_ahead",
      "vibrate": true,
      "priority": "critical",
      "repeat": true
    },
    {
      "id": "flood",
      "trigger": "hazard_type_flood",
      "voice_key": "flood_warning",
      "vibrate": true,
      "priority": "critical"
    },
    {
      "id": "road_closed",
      "trigger": "hazard_type_road_closed",
      "voice_key": "road_closed",
      "vibrate": true,
      "priority": "high"
    },
    {
      "id": "weather_severe",
      "trigger": "weather_alert_high",
      "voice_key": "weather_alert",
      "vibrate": true,
      "priority": "high"
    },
    {
      "id": "gps_lost",
      "trigger": "gps_signal_lost",
      "voice_key": "gps_weak",
      "vibrate": false,
      "priority": "medium"
    },
    {
      "id": "off_route",
      "trigger": "user_off_route",
      "voice_key": "recalculating",
      "vibrate": true,
      "priority": "medium"
    },
    {
      "id": "general",
      "trigger": "manual_or_system",
      "voice_key": "alarm_general",
      "vibrate": true,
      "priority": "medium"
    }
  ],
  "notes": [
    "Alarm inaweza kuwa sauti (TTS) + vibration + on-screen notification.",
    "Priority: critical > high > medium > low."
  ]
}
