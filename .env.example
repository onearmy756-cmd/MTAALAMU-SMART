# ============================================================
# MTAALAMU SMART — environment variables (PLACEHOLDERS ONLY)
# ------------------------------------------------------------
# Source of truth: Infisical (project "mtaalamu-smart", environment "dev").
# Do NOT put real secret values in this file or any committed file.
# Import these keys into Infisical (drag & drop), then run the app via:
#   infisical run --env=dev -- <command>
# The application keeps reading process env / Sys.getenv / os.environ unchanged.
# ============================================================

# --- AI providers (engine-rust/src/web.rs) ---
# Ollama Cloud: pata key bure kwenye ollama.com → sign in → Settings → API Keys.
# Inawasha modeli za cloud (gpt-oss:20b/120b, gemma4:31b...) — angalia data/ai/models.json.
# WEKA THAMANI YAKE INFISICAL PEKEE (infisical secrets set OLLAMA_API_KEY), si hapa.
OLLAMA_API_KEY=
HF_TOKEN=

# --- M-Pesa Daraja (fundi-mobile/src/payments.rs) ---
FUNDI_MPESA_KEY=
FUNDI_MPESA_SECRET=
FUNDI_MPESA_SHORTCODE=
FUNDI_MPESA_PASSKEY=
FUNDI_MPESA_ENV=sandbox

# --- FUNDI PAY manual receivers ---
FUNDI_PAY_TIGO_MSISDN=
FUNDI_PAY_AIRTEL_MSISDN=
FUNDI_PAY_HALO_MSISDN=
FUNDI_PAY_BANK_ACCOUNT=

# --- Card / aggregator ---
FUNDI_PAY_CARD_ENDPOINT=
FUNDI_PAY_CARD_KEY=

# --- Fundi Deploy API (fundi-deploy/server) ---
FUNDI_TOKEN=
DATABASE_URL=sqlite:///data/fundi.db
FUNDI_CLOUD_URL=disabled
FUNDI_TENANT_ID=local

# --- Service URLs / non-secret config ---
SEARXNG_URL=http://127.0.0.1:8888
FUNDI_DEPLOY_URL=http://127.0.0.1:8080
FUNDI_DATA=../data

# --- HERMES workers (services/hermes_agents/worker.py) ---
HERMES_WORKERS_PORT=8090
HERMES_GATEWAY_URL=http://127.0.0.1:8088
OLLAMA_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen2.5:3b
WHISPER_MODEL=small
CRAWL_OUTPUT_DIR=../../data/knowledge/crawl
CRAWL_ALLOWED_HOSTS=en.wikipedia.org,sw.wikipedia.org,docs.who.int,www.who.int,farmos.org,www.openmrs.org

# --- MTAALAMU × Hermes plugin (hermes-agent/plugins/mtaalamu) ---
# Channels halisi — thamani ziwe Infisical PEKEE, si hapa.
# WhatsApp inatumika kupitia Hermes gateway (cli-config.yaml → channels.whatsapp)
FUNDI_SMS_URL=
FUNDI_SMTP_HOST=
FUNDI_SMTP_PORT=587
FUNDI_SMTP_USER=
FUNDI_SMTP_PASS=
# Kiungo cha repo root (hiari — plugin inajitambua yenyewe ndani ya repo)
MTAALAMU_ROOT=
