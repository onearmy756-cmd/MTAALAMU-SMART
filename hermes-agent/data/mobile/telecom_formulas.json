      { "p": "Interference 2.4 GHz", "s": "Tumia channels 1/6/11 au 5 GHz" },
      { "p": "DHCP pool imejaa", "s": "Ongeza pool; punguza lease time" },
      { "p": "Roaming hazei", "s": "SSID ile ile + power tuning + same VLAN" }
    ]}
  ]
}
