      "name": {
        "sw": "Nr Arfcn Calc",
        "en": "Nr Arfcn Calc"
      },
      "formula": "(P_out + P_in + V_out + V_in) / 4",
      "description": {
        "sw": "5G NR: Nr Arfcn Calc",
        "en": "5G New Radio: Nr Arfcn Calc"
      },
      "inputs": [
        {
          "name": "P_in",
          "label": {
            "sw": "Nishati In",
            "en": "Input Power"
          },
          "unit": "W",
          "default": 1,
          "min": 0.001,
          "max": 1000000
        },
        {
          "name": "P_out",
          "label": {
            "sw": "Nishati Out",
            "en": "Output Power"
          },
          "unit": "W",
          "default": 10,
          "min": 0.001,
          "max": 10000000
        },
        {
          "name": "BW",
          "label": {
            "sw": "Bandwidth",
            "en": "Bandwidth"
          },
          "unit": "Hz",
          "default": 1000000,
          "min": 1,
          "max": 1000000000000
        },
        {
          "name": "T",
          "label": {
            "sw": "Joto (K)",
            "en": "Temperature"
          },
          "unit": "K",
          "default": 290,
          "min": 0,
          "max": 1000
        },
        {
          "name": "freq_mhz",
          "label": {
            "sw": "Freq (MHz)",
            "en": "Freq (MHz)"
          },
          "unit": "MHz",
          "default": 3500,
          "min": 400,
          "max": 52600
        }
      ],
      "outputs": [
        {
          "name": "out0",
          "label": {
            "sw": "Matokeo ya nr arfcn calc",
            "en": "Result: nr arfcn calc"
          },
          "expr": "(P_out + P_in + V_out + V_in) / 4",
          "unit": "",
          "digits": 3
        }
      ],
      "steps": [
        {
          "label": "Formula",
          "text": "(P_out + P_in + V_out + V_in) / 4"
        },
        {
          "label": "Weka thamani",
          "expr": "(P_out + P_in + V_out + V_in) / 4",
          "template": "Matokeo = {{result}}"
        }
      ],
      "rules": [
        {
          "check": "out0 >= 0",
          "status": "GOOD",
          "msg": {
            "sw": "Thamani nzuri",
            "en": "Good value"
          }
        },
        {
          "check": "true",
          "status": "WARNING",
          "msg": {
            "sw": "Angalia vigezo",
            "en": "Check constraints"
          }
        }
      ],
      "standards": {
        "sw": [
          "Kundi KUNDI 10"
        ],
        "en": [
          "KUNDI 10"
        ]
      },
      "test": {
        "inputs": {
          "P_in": 1,
          "P_out": 10,
          "BW": 1000000,
          "T": 290,
          "freq_mhz": 3500
        },
        "expect": {}
      }
    },
