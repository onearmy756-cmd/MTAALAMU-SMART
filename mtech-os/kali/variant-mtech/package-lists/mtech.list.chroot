## MTECH OS — variant ya Kali Linux (OS HALISI kama Kali)
##   Jenga:  ./mtech-os/kali/build-iso.sh            # Kali kamili (≈ kali-linux-large)
##           ./mtech-os/kali/build-iso.sh --everything  # zana ZOTE za Kali (kali-linux-everything)

## Live images always want these
kali-linux-core
kali-desktop-live

## Desktop halisi ya Kali (kama picha: XFCE + dragon wallpaper + panel + menyu za zana)
kali-desktop-xfce
kali-themes
kali-wallpapers
kali-menu
kali-tweaks
xdg-user-dirs
gvfs-backends
firefox-esr
conky-all

## Zana za Kali halisi
##   kali-linux-large  = seti kamili ya Kali rasmi (kali-linux-default + extra, ≈ tools 400+)
##   kali-linux-everything = ZOTE (~1800) — badalishwa na build-iso.sh --everything
kali-linux-large

## Kernel na DRIVERS halisi za Kali (WiFi, GPU, USB, sound…)
linux-image-amd64
linux-headers-amd64
firmware-linux
firmware-linux-nonfree
firmware-misc-nonfree
firmware-realtek
firmware-atheros
firmware-iwlwifi
firmware-brcm80211
firmware-libertas
firmware-sof-signed

## Kernel dev (module ya /dev/mtech na eBPF)
bpfcc-tools
bpftool
clang
llvm
libbpf-dev

## Akili ya MTAALAMU SMART (app ya desktop + API ya systemd)
python3
python3-pip
python3-venv
python3-dev
python3-pil
curl
git
wget
unzip
xz-utils
file

## Udhibiti wa GUI na vision (macho/mikono ya MTAALAMU)
xdotool
wmctrl
scrot
xclip
imagemagick
pulseaudio-utils
