<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- MTECH OS LaunchAgent (macOS): MTAALAMU inaload na login; placeholders zinabadilishwa na installer. -->
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.mtech.mtaalamu</string>
    <key>ProgramArguments</key>
    <array>
        <string>__MTAALAMU_PYTHON__</string>
        <string>__MTAALAMU_GUI__</string>
    </array>
    <key>RunAtLoad</key>
    <true/>
    <key>KeepAlive</key>
    <false/>
    <key>StandardOutPath</key>
    <string>/tmp/mtech-mtaalamu.log</string>
    <key>StandardErrorPath</key>
    <string>/tmp/mtech-mtaalamu.log</string>
</dict>
</plist>
